{
	# 经 Cloudflare 代理时，用 CF 回源头还原真实客户端 IP；
	# 只有来自下列 CF 网段的连接才被采信，直连来源无法伪造。
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
}

{$API_DOMAIN} {
	# 静态资源（模型/供应商图标等），走自己的域名 + Cloudflare 缓存
	handle_path /static/* {
		root * /srv/static
		file_server
		header Cache-Control "public, max-age=86400"
	}

	# 其余全部转给 New API
	handle {
		reverse_proxy new-api:3000 {
			# SSE / 流式响应必须逐块下发，不能让代理缓冲
			flush_interval -1
			transport http {
				dial_timeout 10s
				read_timeout 600s
				write_timeout 600s
			}
		}
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	log {
		output stdout
		format console
	}
}

# 1Panel 管理面板：1Panel 自身只监听 127.0.0.1:33765 的明文 HTTP，
# 由 Caddy 终止 TLS 后回源。1Panel 的 BindDomain 必须与这里的主机名一致，
# 且访问路径要带安全入口（/renhaozuiqiang）。
{$PANEL_DOMAIN:pan.520dzm.app} {
	reverse_proxy host.docker.internal:33765 {
		# WebSocket（1Panel 终端/日志实时刷新）依赖连接升级，Caddy 默认已处理
		transport http {
			dial_timeout 5s
			read_timeout 300s
			write_timeout 300s
		}
	}

	header {
		-Server
	}

	log {
		output stdout
		format console
	}
}
