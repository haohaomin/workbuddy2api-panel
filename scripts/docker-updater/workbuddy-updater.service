[Unit]
Description=WorkBuddy Docker web update agent
Requires=docker.service
After=docker.service

[Service]
Type=simple
User=root
ExecStart=/usr/bin/python3 /usr/local/lib/workbuddy-updater/agent.py --config /etc/workbuddy-updater.json
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=15
RuntimeDirectory=workbuddy-updater
RuntimeDirectoryMode=0755
# Preserve the directory inode across service restarts: it is bind-mounted.
RuntimeDirectoryPreserve=yes
StateDirectory=workbuddy-updater
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
